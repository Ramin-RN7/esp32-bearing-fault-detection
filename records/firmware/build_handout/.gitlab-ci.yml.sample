stages: [build]
build-core2:
  stage: build
  image: espressif/idf:release-v4.4
  script:
    - export IDF_PATH="$CI_PROJECT_DIR/firmware/esp-idf"
    - source "$IDF_PATH/export.sh"
    - cd firmware/micropython/ports/esp32
    - idf.py -DMICROPY_BOARD=CORE2 -DUSER_C_MODULES="$CI_PROJECT_DIR/usermods/micropython.cmake" build
    - pip3 install --user esptool>=4.0
    - python3 -m esptool --chip esp32 merge_bin -o "$CI_PROJECT_DIR/micropython-merged.bin" --flash_mode dio --flash_freq 40m --flash_size 4MB 0x1000 build/bootloader/bootloader.bin 0x8000 build/partition_table/partition-table.bin 0x10000 build/micropython.bin
  artifacts:
    paths:
      - firmware/micropython/ports/esp32/build/micropython.bin
      - firmware/micropython/ports/esp32/build/bootloader/bootloader.bin
      - firmware/micropython/ports/esp32/build/partition_table/partition-table.bin
      - micropython-merged.bin
    expire_in: 2 weeks
